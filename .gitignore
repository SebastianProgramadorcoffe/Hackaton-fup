# OS / editor
.DS_Store
Thumbs.db
*.swp

# Installers / archives — never belong in the repo
*.exe
*.msi
*.zip
*.7z
*.rar

# Env / secrets
.env
.env.*
!.env.example
*.key
*.pem
data/.api-key

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
build/

# Local DB / generated data
*.sqlite
*.sqlite3
*.db

# gstack local state
.gstack/

# Symlinks the `skills` CLI creates per machine (core.symlinks=false here
# would commit them as broken text files). Source of truth is .agents/skills/
# + skills-lock.json; regenerate with: npx skills experimental_install
.claude/skills/
