# Copia este archivo a .env (ya está en .gitignore, nunca lo subas) y completa tu clave.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Opcional: URL de un webhook entrante (Slack/Discord/Teams, formato {"text": "..."})
# para que scripts/check_alerts.py notifique alertas de camas/inventario.
# Sin esto, el script solo imprime en consola/log.
ALERTS_WEBHOOK_URL=
